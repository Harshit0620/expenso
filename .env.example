# Expenso / SmallSpend — frontend environment variables
#
# Copy this file to `.env` and fill in your own values.
# NEVER commit real credentials. Only the Supabase ANON (public) key belongs
# in the frontend. The service-role key must NEVER be exposed to the browser.
#
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# Base URL of your Supabase project (e.g. https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon/public key (safe for the browser, protected by RLS)
VITE_SUPABASE_ANON_KEY=
